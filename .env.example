# Copy to .env (git-ignored) and change the value: cp .env.example .env
# Compose reads .env automatically and fills ${...} in compose.yaml.
# SQL Server refuses weak passwords: 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
# One login per service, created by db/init.sql. Same password rules. No ' in passwords (it ends the SQL string).
APPDATA_DB_PASSWORD=ChangeMe_Appdata1!
IAM_DB_PASSWORD=ChangeMe_Iam1!
