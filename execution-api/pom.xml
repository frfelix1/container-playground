<?xml version="1.0" encoding="UTF-8"?>
<!--
  execution-api: data operations only (CRUD on projects and records).
  Versions are NOT set here; they are inherited from the parent POM.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Our own parent, one folder up. groupId and version come from it. -->
	<parent>
		<groupId>com.provisio</groupId>
		<artifactId>provisio-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>execution-api</artifactId>

	<dependencies>
		<!--
		  Spring MVC + embedded Tomcat + Jackson (JSON).
		  Note: Spring Boot 4 renamed the old "starter-web" to "starter-webmvc".
		  No <version>: inherited from parent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
		  The database translator: JPA annotations (@Entity, @Id), Hibernate
		  (the code that turns objects into SQL and rows back into objects),
		  and Spring Data repositories (interface in, working class out).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Flyway: runs db/migration/V*.sql on startup, in version order, once each. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>

		<!-- Flyway's SQL Server add-on. Without it Flyway can't talk to SQL Server. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-sqlserver</artifactId>
		</dependency>

		<!--
		  The SQL Server driver: opens the actual network connection to the database.
		  scope=runtime: our code never uses its classes directly; it's only needed
		  when the app runs (and tests run), not to compile our code.
		-->
		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		  JUnit 5, AssertJ, Mockito and Spring's MVC test support.
		  scope=test: available to tests only, never packaged into the app jar.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Repackages the jar into a runnable "fat jar" (java -jar ...) and adds spring-boot:run. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
